###> symfony/framework-bundle ###
APP_ENV=dev
# Generated into .env.local by `make setup`; never commit a real value here.
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:root@mysql:3306/eventhub?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

REDIS_URL=redis://redis:6379

###> health checks ###
# Leave empty locally: an unset token leaves /health/ready open.
HEALTHCHECK_TOKEN=
###< health checks ###

###> sentry/sentry-symfony ###
# Empty locally: the SDK loads but reports nothing. Set it in production to a project DSN.
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> api documentation ###
# HTTP Basic credentials for /api/doc and /api/doc.json. Ignored under APP_ENV=dev and
# test (the docs are open there). In any other environment the docs answer 503 until a
# password is set.
DOCS_USERNAME=docs
DOCS_PASSWORD=
###< api documentation ###

###> provider configuration ###
PROVIDER_EVENTS_URL=http://provider:8080/events.xml
PROVIDER_MODE=static
###< provider configuration ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_TOKEN_TTL=3600
# Generated into .env.local and .env.test.local by `make jwt-keys`, together with the
# key pair it protects. Regenerating one without the other breaks token signing.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
