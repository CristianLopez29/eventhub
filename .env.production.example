# Production environment. Copy to .env on the server and fill in every <...> placeholder.
# Start from this file, never from the development .env.
#
#   openssl rand -hex 32      APP_SECRET, HEALTHCHECK_TOKEN, JWT_PASSPHRASE
#   openssl rand -base64 24   DB_PASSWORD, DB_ROOT_PASSWORD, REDIS_PASSWORD

###> application ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<openssl rand -hex 32>
# The hostname Traefik matches on. Point its A record at this host BEFORE first start,
# or the TLS-ALPN challenge fails and repeated failures hit Let's Encrypt rate limits.
APP_DOMAIN=<eventhub.example.com>
###< application ###

###> database ###
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=<openssl rand -base64 24>
# Initialises the MySQL container; the application never uses it.
DB_ROOT_PASSWORD=<openssl rand -base64 24>
DATABASE_URL="mysql://eventhub:<DB_PASSWORD>@mysql:3306/eventhub?serverVersion=8.0.32&charset=utf8mb4"
###< database ###

###> cache ###
REDIS_PASSWORD=<openssl rand -base64 24>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
###< cache ###

###> health checks ###
# Required in production: /health/ready is open while this is empty.
HEALTHCHECK_TOKEN=<openssl rand -hex 32>
###< health checks ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# The entrypoint generates the key pair with this passphrase on first boot and keeps it in
# the jwt_keys volume. Change it and the existing keys stop opening — regenerate both.
JWT_PASSPHRASE=<openssl rand -hex 32>
JWT_TOKEN_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> provider ###
# The real provider feed. The mock provider container is not part of the production stack.
PROVIDER_EVENTS_URL=<https://provider.example.com/events.xml>
# How often the scheduler container runs app:sync-events.
SYNC_INTERVAL_SECONDS=3600
###< provider ###

###> symfony/routing ###
DEFAULT_URI=https://<eventhub.example.com>
###< symfony/routing ###
